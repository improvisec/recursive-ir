[Unit]
Description=Run dfir ingest parse every 10 seconds

[Timer]
# first run 10 seconds after boot
OnBootSec=10s

# then every 10 seconds after the service finishes
OnUnitInactiveSec=10s

# ensure missed runs are not replayed after long downtime
Persistent=false

Unit=dfir-parser.service

[Install]
WantedBy=timers.target
