[Unit]
Description=Recursive-IR worker (job executor)
After=network-online.target
Wants=network-online.target

# Do not run until the runtime env exists
ConditionPathExists=/etc/recursive-ir/env/recursive.env

[Service]
Type=simple
User=dfir
Group=recursive

# Repo location (written by: dfir init)
EnvironmentFile=/etc/recursive-ir/env/paths.env

# Runtime configuration
EnvironmentFile=/etc/recursive-ir/env/recursive.env

# Long-running poller
ExecStart=/usr/local/bin/dfir worker run --env-file /etc/recursive-ir/env/recursive.env

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
