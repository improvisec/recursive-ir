[Unit]
Description=Recursive-IR Security Analytics findings collector
After=network-online.target
Wants=network-online.target

# Do not run until the runtime env exists
ConditionPathExists=/etc/recursive-ir/env/recursive.env

[Service]
Type=oneshot
User=dfir
Group=recursive

# Repo location (written by: dfir init)
EnvironmentFile=/etc/recursive-ir/env/paths.env

# Runtime configuration
EnvironmentFile=/etc/recursive-ir/env/recursive.env

# Working directory
WorkingDirectory=/var/run/recursive-ir

# Discover current detector/monitor IDs on every cycle and drain all
# native findings that are newer than each monitor's durable checkpoint.
ExecStart=/usr/local/bin/dfir security-analytics findings collect-all --once --page-size 500 --json
