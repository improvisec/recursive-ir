[Unit]
Description=Recursive-IR enrich projection (all cases)
After=network-online.target
Wants=network-online.target

# Do not run until the runtime env exists
ConditionPathExists=/etc/recursive-ir/env/recursive.env

[Service]
Type=oneshot
User=dfir
Group=recursive

EnvironmentFile=/etc/recursive-ir/env/paths.env
EnvironmentFile=/etc/recursive-ir/env/recursive.env

# Project queued enrichments for every case that has an enrichments DB.
# NOTE: cmd_enrich requires --case, so we enumerate cases first.
ExecStart=/bin/sh -lc '\
  set -e; \
  /usr/local/bin/dfir enrich cases | while IFS= read -r c; do \
    [ -n "$c" ] || continue; \
    /usr/local/bin/dfir enrich project --case "$c" --batch 2000 --commit; \
  done \
'
