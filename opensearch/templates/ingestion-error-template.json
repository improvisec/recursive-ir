{
  "index_patterns": [
    "ingestion-error-*"
  ],
  "priority": 300,
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.codec": "best_compression"
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "@version": {
          "type": "keyword"
        },

        "document_id": {
          "type": "keyword",
          "ignore_above": 256
        },

        "tags": {
          "type": "keyword"
        },

        "case_id": {
          "type": "keyword"
        },
        "source_type": {
          "type": "keyword"
        },

        "host_ip": {
          "type": "ip"
        },
        "hostname": {
          "type": "keyword"
        },

        "size": {
          "type": "long"
        },

        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": {
                  "type": "keyword",
                  "ignore_above": 4096
                }
              }
            }
          }
        },

        "dlq": {
          "properties": {
            "entry_time": {
              "type": "date",
              "format": "strict_date_optional_time_nanos"
            },

            "orig_source_type": {
              "type": "keyword"
            },
            "orig_index": {
              "type": "keyword"
            },
            "orig_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "orig_timestamp": {
              "type": "date"
            },

            "plugin_id": {
              "type": "keyword",
              "ignore_above": 256
            },
            "plugin_type": {
              "type": "keyword"
            },

            "error_type": {
              "type": "keyword"
            },
            "error_field": {
              "type": "keyword"
            },
            "error_from_type": {
              "type": "keyword"
            },
            "error_to_type": {
              "type": "keyword"
            },

            "error_preview": {
              "type": "keyword",
              "ignore_above": 4096
            },

            "error_message": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },

            "error_cause": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },

            "summary": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },

            "reason": {
              "type": "text",
              "index": false
            }
          }
        }
      }
    },
    "aliases": {
      "all-json": {},
      "all": {}
    }
  },
  "_meta": {
    "project": "Recursive-IR",
    "copyright": "Copyright (c) 2026 Mark Jayson Alvarez",
    "license": "Recursive-IR License",
    "desc": "Ingestion error events from Logstash Dead Letter Queue."
  },
  "version": 1
}
